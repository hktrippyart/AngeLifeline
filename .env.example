# Required for country/EMS resolution from chat (Gemini + Google Search)
GEMINI_API_KEY=

# Optional — ISO country + address from Places (no POI front-desk phones)
GOOGLE_MAPS_API_KEY=

# Optional — live suicide/crisis helplines (Find A Helpline / ThroughLine OAuth)
THROUGHLINE_CLIENT_ID=
THROUGHLINE_CLIENT_SECRET=
# Alternates: FINDAHELPLINE_CLIENT_ID / FINDAHELPLINE_CLIENT_SECRET
